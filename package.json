{
  "name": "@davideddr/strapi-plugin-opensearch",
  "version": "1.0.0",
  "description": "OpenSearch integration for Strapi 5: real-time indexing of published content and a controlled search endpoint.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi5",
    "opensearch",
    "search",
    "full-text"
  ],
  "license": "MIT",
  "author": {
    "name": "Davide Da Rech",
    "url": "https://github.com/davideddr"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davideddr/strapi-plugin-opensearch"
  },
  "bugs": {
    "url": "https://github.com/davideddr/strapi-plugin-opensearch/issues"
  },
  "homepage": "https://github.com/davideddr/strapi-plugin-opensearch#readme",
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "prepublishOnly": "npm run build && npm run verify",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "OPENSEARCH_TEST_REQUIRED=1 vitest run server/src/__integration__"
  },
  "devDependencies": {
    "@aws-sdk/credential-provider-node": "^3.972.95",
    "@eslint/js": "^10.0.1",
    "@strapi/design-system": "2.2.4",
    "@strapi/icons": "2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.61.1",
    "@strapi/typescript-utils": "^5.61.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "6.6.2",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "~5.0.5"
  },
  "peerDependencies": {
    "@aws-sdk/credential-provider-node": "^3.972.95",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/strapi": "^5.61.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.6.2",
    "react-router-dom": "^6.30.3",
    "styled-components": "^6.0.0"
  },
  "engines": {
    "node": ">=22.0.0 <=26.x.x"
  },
  "strapi": {
    "kind": "plugin",
    "name": "opensearch",
    "displayName": "OpenSearch",
    "description": "Index published content into OpenSearch and search it through a controlled API."
  },
  "dependencies": {
    "@opensearch-project/opensearch": "^3.9.0",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/credential-provider-node": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
